#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
QUICompare CLI Wrapper 4.1.5 (Melhorado)
"""

import sys
import os
import subprocess
import shutil
import stat

# Mapear modos -> scripts reais
MODE_MAP = {
    "--superlight": "quicompare-mpeg-superlight.py",
    "--mono-light": "quicompare-mpeg-light-mono.py",
    "--multi-light": "quicompare-mpeg-light-multi.py",
    "--mono-full":  "quicompare-mpeg-mono-plots.py",
    "--multi-full": "quicompare-mpeg-multi-plots.py",
    "--auto":       "quicompare-auto.py",
}

def make_executable(path):
    """Garante que o script alvo tenha permissão de execução."""
    st = os.stat(path)
    os.chmod(path, st.st_mode | stat.S_IEXEC)

def main():
    if len(sys.argv) < 2:
        print("Uso do QUICompare:")
        for k, v in MODE_MAP.items():
            print(f"  quicompare {k} <args...>  -> Chama {v}")
        sys.exit(1)

    mode = sys.argv[1]
    
    # Ajuda rápida para comandos comuns de help
    if mode in ["-h", "--help", "help"]:
        print("Ajuda do QUICompare:")
        print("Sintaxe: quicompare <modo> [opções do modo]")
        print("\nModos disponíveis:")
        for k in MODE_MAP:
            print(f"  {k}")
        sys.exit(0)

    if mode not in MODE_MAP:
        print(f"ERRO: Modo '{mode}' não reconhecido.")
        print("Tente 'quicompare --help' para ver os modos disponíveis.")
        sys.exit(1)

    script_name = MODE_MAP[mode]
    args = sys.argv[2:]

    # 1. Tenta achar o script na mesma pasta do wrapper (MÉTODO PREFERIDO)
    wrapper_path = os.path.abspath(sys.argv[0])
    wrapper_dir = os.path.dirname(wrapper_path)
    candidate = os.path.join(wrapper_dir, script_name)

    # 2. Se não achar, tenta no PATH do sistema
    if not os.path.exists(candidate):
        alt = shutil.which(script_name)
        if alt:
            candidate = alt
        else:
            print(f"ERRO CRÍTICO: Não encontrei o script '{script_name}'.")
            print(f"Certifique-se de que o arquivo '{script_name}' está na pasta: {wrapper_dir}")
            sys.exit(1)

    # Tenta dar permissão de execução automaticamente se necessário
    try:
        make_executable(candidate)
    except Exception as e:
        # Apenas avisa, não para (pode ser executado via python diretamente)
        pass

    # Executa chamando o interpretador Python explicitamente para evitar erros de shebang
    cmd = [sys.executable, candidate] + args
    
    try:
        subprocess.check_call(cmd)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
    except KeyboardInterrupt:
        sys.exit(130)

if __name__ == "__main__":
    main()